# syntax=docker/dockerfile:1.7
# Production-ready Migration Image
FROM node:24-bookworm-slim

WORKDIR /app

ENV NPM_CONFIG_FETCH_RETRIES=5 \
    NPM_CONFIG_FETCH_RETRY_FACTOR=2 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000 \
    NPM_CONFIG_FETCH_TIMEOUT=300000 \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false

# Install required system dependencies (if any)
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Use the committed monorepo lockfile and install only the backend workspace.
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY dashboard/web-ui/package.json dashboard/web-ui/
COPY packages/react-native/package.json packages/react-native/
COPY packages/browser/package.json packages/browser/

RUN --mount=type=cache,target=/root/.npm \
    for attempt in 1 2 3; do \
      npm ci --workspace backend --include-workspace-root=false --omit=dev --ignore-scripts && break; \
      status=$?; \
      if [ "$attempt" -eq 3 ]; then exit "$status"; fi; \
      echo "npm ci --omit=dev failed (attempt ${attempt}/3); retrying..."; \
      sleep $((attempt * 15)); \
    done

# Copy source, config, and bootstrap scripts after dependencies for cache reuse.
WORKDIR /app/backend
COPY --chown=node:node backend/drizzle.config.ts ./
COPY --chown=node:node backend/clickhouse ./clickhouse
COPY --chown=node:node backend/drizzle ./drizzle
COPY --chown=node:node backend/src ./src
COPY --chown=node:node backend/scripts ./scripts

# Set environment
ENV NODE_ENV=production

USER node

# Default for ad-hoc runs; K8s/Compose override with full bootstrap command
CMD ["node", "--import", "tsx", "scripts/applyDatabaseSchema.ts"]
