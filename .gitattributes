* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.avif binary
*.gif binary
*.gz binary
*.heic binary
*.ico binary
*.jar binary
*.jpeg binary
*.jpg binary
*.keystore binary
*.mp4 binary
*.pdf binary
*.png binary
*.tgz binary
*.ttf binary
*.webp binary
*.woff2 binary
*.zip binary
*.aar binary

# Unity writes empty YAML values with a trailing space when serializing assets.
packages/unity/**/*.meta whitespace=-blank-at-eol
examples/unity/**/*.meta whitespace=-blank-at-eol
examples/unity/ProjectSettings/*.asset whitespace=-blank-at-eol
